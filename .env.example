# Copie para .env e ajuste se necessário. Não commite o .env.
APP_ENV=development
API_PORT=8080
WEB_PORT=8081
MONGO_PORT=27017
MONGO_DB=brocados_dev

# Conexão para executar a API fora do Docker (make dev-api).
# No Compose, a API usa o serviço `mongo` automaticamente.
MONGO_URI=mongodb://localhost:27017

# Alias aceito, usado no Render/Atlas. Se ambos existirem, MONGO_URI tem prioridade.
# MONGODB_URI=mongodb+srv://usuario:senha@cluster.exemplo.mongodb.net

# Base usada para montar o link do pedido enviado no webhook. Em desenvolvimento
# o padrão é http://localhost:5173; em produção defina a URL HTTPS do painel ou
# deixe vazio para omitir o link até o domínio ser decidido.
# ADMIN_BASE_URL=https://admin.exemplo.com

# Segredo usado para emitir o token de "Meus pedidos". Em desenvolvimento há um
# valor padrão; em produção é obrigatório e deve ter pelo menos 32 caracteres.
# Nunca commite o valor de produção nem o altere sem aceitar a perda dos tokens.
# ORDER_ACCESS_SECRET=substitua-por-um-segredo-aleatorio-de-producao

# Autenticação do painel (US-060). Em produção o nome ganha o prefixo __Host-
# e o cookie é Secure automaticamente.
ADMIN_SESSION_COOKIE=brocados_admin

# Opcional: bootstrap do primeiro usuário owner. Defina as três variáveis juntas
# apenas na primeira inicialização; depois remova-as do ambiente. Use uma senha
# real de pelo menos 12 caracteres e nunca commite esse valor.
# ADMIN_BOOTSTRAP_NAME=Dono
# ADMIN_BOOTSTRAP_EMAIL=dono@example.com
# ADMIN_BOOTSTRAP_PASSWORD=substitua-por-uma-senha-forte

# Monitoramento de erros (opcional). Sem DSN, nem a API nem o web enviam eventos.
# Use projetos separados para API e web; o DSN do navegador é incorporado no build.
# SENTRY_DSN=https://chave@sentry.exemplo.com/1
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=
# SENTRY_FLUSH_TIMEOUT_SECONDS=2
# VITE_SENTRY_DSN=https://chave@sentry.exemplo.com/2
# VITE_SENTRY_ENVIRONMENT=development
# VITE_SENTRY_RELEASE=
